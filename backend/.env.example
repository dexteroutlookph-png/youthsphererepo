# Server Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app
BACKEND_URL=https://your-project.vercel.app

# PostgreSQL Database Configuration (Neon Cloud)
DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require
DB_SSL=true

# Authentication
SESSION_SECRET=change_this_secure_session_secret
JWT_SECRET=change_this_jwt_secret

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service Setup (Free-tier SMTP or Resend/SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="YouthSphere ISIED" <no-reply@youthsphere-isied.org>

# Initial Admin Credentials (For Database Seeding Only)
SEED_ADMIN_EMAIL=admin@isied-youthsphere.org
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword2026!
SEED_ADMIN_USERNAME=isied_admin